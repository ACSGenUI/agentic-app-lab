# Adobe I/O Runtime MCP Server - Environment Variables
# Copy this file to .env and fill in your values

# Logging
LOG_LEVEL=

# Authentication
# Set AUTH_VALIDATE_IMS=true to enable IMS token validation via Adobe IMS userinfo endpoint
AUTH_VALIDATE_IMS=

# Set SERVICE_API_KEY for simple API key authentication (service-to-service)
SERVICE_API_KEY=

## App specific variables.
baseURL=https://www.bathandbodyworks.com.qa
dataEndpoint=https://www.bathandbodyworks.com.qa/en/query-index.json
# Optional: comma-separated origins for card images (CSP resourceDomains). baseURL origin is always allowed.
RESOURCE_DOMAINS=https://bbwqa-pprod.factory.alshayauat.com,https://www.bathandbodyworks.com.qa
# Exposed to client (used for page title and header)
VITE_APPLICATION_TITLE=Bath & Body Works
VITE_SUB_TITLE=Explore the latest products and promotions from Bath & Body Works.

DATA_ENDPOINT=https://www.bathandbodyworks.com.qa/en/query-index.json
BASE_URL=https://www.bathandbodyworks.com.qa

{
  "name": "sselvara-agentic-app",
  "version": "1.0.0",
  "description": "Model Context Protocol server with Adobe I/O Runtime",
  "main": "actions/mcp-server/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "npm run build:ui && npm run embed:ui && npm run embed:config && webpack",
    "embed:config": "node scripts/embed-config.js",
    "build:ui": "npm run build:product-list && npm run build:product-detail && npm run build:cart",
    "embed:ui": "node scripts/embed-ui.js",
    "build:product-list": "vite build --config actions/mcp-server/commerce-app/vite.config.mjs",
    "build:product-detail": "APP=product-detail vite build --config actions/mcp-server/commerce-app/vite.config.mjs",
    "build:cart": "APP=cart vite build --config actions/mcp-server/commerce-app/vite.config.mjs",
    "deploy": "npm run build && aio app deploy",
    "undeploy": "aio app undeploy",
    "dev": "aio app run",
    "dev:local": "node local-server.js",
    "start": "node local-server.js",
    "lint": "eslint actions/",
    "format": "prettier --write actions/"
  },
  "dependencies": {
    "@adobe/aio-sdk": "^5.0.0",
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "dotenv": "^16.3.1",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0",
    "@adobe/generator-app-remote-mcp-server-generic": "^0.1.8"
  },
  "keywords": [
    "adobe-io",
    "mcp",
    "model-context-protocol",
    "serverless",
    "template",
    "i/o-runtime"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/YOUR_REPO_NAME.git"
  },
  "license": "MIT",
  "author": "sselvara <your.email@example.com>",
  "aio-app-builder-templates": [
    "@adobe/generator-app-remote-mcp-server-generic"
  ]
}
